{
  "name": "gdtdevsur",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/publish-static.mjs",
    "preview": "astro preview",
    "indexnow": "node scripts/indexnow.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "start": "node ./dist/server/entry.mjs",
    "deploy": "astro build && wrangler deploy",
    "deploy:cf": "ASTRO_ADAPTER=cloudflare astro build && wrangler deploy",
    "cf:login": "wrangler login",
    "seed": "node scripts/seed.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env scripts/seed-db.mjs",
    "db:studio": "prisma studio",
    "admin:password": "node --env-file=.env scripts/admin-user.mjs",
    "db:setup": "docker compose up -d && prisma db push && node --env-file=.env scripts/seed-db.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node --env-file=.env scripts/seed-db.mjs"
  },
  "keywords": [
    "astro",
    "cms",
    "agencia",
    "gdtdevsur"
  ],
  "author": "GDT DevSur",
  "license": "UNLICENSED",
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@prisma/client": "^6.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.56.0",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.150.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.0",
    "typescript": "^7.0.2"
  }
}
