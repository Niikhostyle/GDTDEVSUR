---
/**
 * Home GDT DevSur — Carbón & Crema + motion MMD
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Portfolio from "../components/Portfolio.astro";
import Services from "../components/Services.astro";
import ServicesDetail from "../components/ServicesDetail.astro";
import WhyWeb from "../components/WhyWeb.astro";
import SectionArc from "../components/SectionArc.astro";
import MarqueeBand from "../components/MarqueeBand.astro";
import Clients from "../components/Clients.astro";
import Process from "../components/Process.astro";
import CtaContact from "../components/CtaContact";
import Faq from "../components/Faq";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import Reveal from "../components/Reveal.astro";
import MotionCraft from "../components/MotionCraft.astro";
import JsonLd from "../components/JsonLd.astro";
import { getCollection } from "../lib/cms";
import { getLocaleFromRequest } from "../lib/locale";
import { filterNavByModules } from "../lib/nav";

const locale = getLocaleFromRequest(Astro.request);
const site = await getCollection<any>("site", locale);
const hero = await getCollection<any>("hero", locale);
const about = await getCollection<any>("about", locale);
const services = await getCollection<any>("services", locale);
/** Stats strip: CMS only (colección `why.stats`). Empty array = hidden, no hardcoded fallback. */
const why = await getCollection<any>("why", locale);
const portfolio = await getCollection<any>("portfolio", locale);
const clients = await getCollection<any>("clients", locale);
const process = await getCollection<any>("process", locale);
const faq = await getCollection<any>("faq", locale);
const contact = await getCollection<any>("contact", locale);

const nav = filterNavByModules(site.nav, {
  hero,
  about,
  services,
  portfolio,
  clients,
  process,
  faq,
  contact,
  differentials: { enabled: false },
  blog: { enabled: false },
  news: { enabled: false },
});

const asStrings = (list: unknown): string[] =>
  Array.isArray(list)
    ? list
        .map((item) =>
          typeof item === "string"
            ? item
            : item && typeof item === "object" && "value" in item
              ? String((item as { value?: unknown }).value ?? "")
              : "",
        )
        .filter(Boolean)
    : [];

const marqueeItems = asStrings(site.marquee);
const sitePhones = asStrings(site.phones).length ? asStrings(site.phones) : (site.phones || []);
const siteEmails = asStrings(site.emails).length ? asStrings(site.emails) : (site.emails || []);
---

<Layout
  title={site.seo.title}
  description={site.seo.description}
  ogImage={site.seo.ogImage || "/og-default.jpg"}
  locale={locale}
  keywords={site.seo.keywords}
  brandName={site.brandName}
>
  <JsonLd
    brandName={site.brandName}
    description={site.seo.description}
    emails={siteEmails}
    phones={sitePhones}
    faqItems={faq.items}
    locale={locale}
    social={site.social}
    pageType="WebPage"
    pageTitle={site.seo.title}
    pageDescription={site.seo.description}
    breadcrumbs={[
      { name: locale === "en" ? "Home" : "Inicio", path: "/" },
    ]}
    services={(services.items || []).map((item: { title: string; description?: string }) => ({
      name: item.title,
      description: item.description,
    }))}
  />
  <Header
    brandName={site.brandName}
    logoText={site.logoText || site.brandName}
    nav={nav}
    cta={site.ctaPrimary}
    locales={site.locales}
    defaultLocale={locale}
    phone={sitePhones[0] || ""}
    whatsappPrefill={site.whatsappPrefill || ""}
  />
  <main class="overflow-x-clip">
    {
      hero.enabled !== false && (
        <Hero
          {...hero}
          brandTitle={hero.brandTitle || site.logoText || site.brandName}
          metaLine={hero.metaLine || hero.trustLabel || site.tagline}
        />
      )
    }
    {hero.enabled !== false && <MarqueeBand items={marqueeItems} />}
    {
      hero.enabled !== false && (about.enabled !== false || services.enabled !== false) && (
        <SectionArc to="paper" />
      )
    }
    {about.enabled !== false && <About {...about} />}
    {
      services.enabled !== false && (
        <Services
          eyebrow={services.eyebrow}
          title={services.title}
          titleLight={services.titleLight}
          titleBold={services.titleBold}
          subtitle={services.subtitle}
          items={services.items}
        />
      )
    }

    {why?.enabled !== false && (
      <>
        <SectionArc to="ink" />
        <WhyWeb {...why} />
        <SectionArc to="paper" />
      </>
    )}

    {
      services.enabled !== false && services.detail?.items?.length > 0 && (
        <ServicesDetail
          eyebrow={services.detail.eyebrow}
          titleLight={services.detail.titleLight}
          titleBold={services.detail.titleBold}
          subtitle={services.detail.subtitle}
          items={services.detail.items}
        />
      )
    }

    {portfolio.enabled !== false && <Portfolio {...portfolio} />}
    {clients.enabled !== false && <Clients {...clients} locale={locale} />}
    {
      process.enabled !== false && (
        <Process
          eyebrow={process.eyebrow}
          title={process.title}
          titleLight={process.titleLight}
          titleBold={process.titleBold}
          subtitle={process.subtitle}
          steps={process.steps}
          stackTitle={process.stackTitle}
          stack={process.stack}
        />
      )
    }

    <SectionArc to="ink" />

    {
      faq.enabled !== false && (
        <Faq
          client:load
          eyebrow={faq.eyebrow}
          title={faq.title}
          titleOutline={faq.titleOutline}
          titleSolid={faq.titleSolid}
          subtitle={faq.subtitle}
          ctaLabel={faq.ctaLabel}
          ctaHref={faq.ctaHref}
          items={faq.items}
        />
      )
    }

    {
      contact.enabled !== false && (
        <CtaContact
          client:load
          title={contact.title}
          titleLight={contact.titleLight}
          titleBold={contact.titleBold}
          eyebrow={contact.eyebrow}
          subtitle={contact.subtitle}
          successMessage={contact.successMessage}
          submitLabel={contact.submitLabel}
          whatsappHint={contact.whatsappHint}
          serviceLabel={contact.serviceLabel}
          budgetLabel={contact.budgetLabel}
          serviceOptions={contact.serviceOptions || []}
          budgetOptions={contact.budgetOptions || []}
          phone={sitePhones[0] || ""}
          fields={contact.fields}
          locale={locale}
        />
      )
    }
  </main>
  <Footer
    brandName={site.brandName}
    footerNote={site.footerNote}
    footerBlurb={site.footerBlurb || ""}
    emails={siteEmails}
    phones={sitePhones}
    nav={nav}
    locale={locale}
    mapLabel={site.footerMapLabel}
    contactLabel={site.footerContactLabel}
    location={contact.location || ""}
    locationLabel={contact.locationLabel}
    emailLabel={contact.emailLabel}
    whatsappLabel={contact.whatsappLabel}
    contactEmail={(typeof contact.email === "string" && contact.email.trim()) || siteEmails[0] || ""}
  />
  <WhatsAppFloat phone={sitePhones[0] || ""} />
  <SmoothScroll />
  <Reveal />
  <MotionCraft />
</Layout>
