---
interface Props {
  eyebrow?: string;
  brandTitle?: string;
  headline: string;
  headlineBold?: string;
  headlineRest?: string;
  headlineAccent?: string;
  subheadline: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  stats?: { value: string; label: string }[];
  trustLabel?: string;
  metaLine?: string;
  backgroundImage?: string;
}

const {
  brandTitle = "",
  headline,
  headlineBold = "",
  headlineRest = "",
  headlineAccent = "",
  subheadline,
  primaryCta,
  secondaryCta,
  trustLabel = "",
  metaLine = "",
} = Astro.props;

const brand = brandTitle.trim();
const meta = (metaLine || trustLabel).trim();
---

<section
  id="inicio"
  class="hero-sur relative flex min-h-[100svh] flex-col justify-end overflow-hidden bg-[var(--color-ink)] text-[var(--color-paper)]"
  data-hero
>
  <div class="hero-sur__fx" aria-hidden="true">
    <div class="hero-sur__lines"></div>
    <div class="hero-sur__glow"></div>
    <div class="hero-sur__glow hero-sur__glow--soft"></div>
    <div class="hero-sur__veil" data-hero-veil></div>
  </div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-[1240px] flex-col gap-0 px-5 pb-10 pt-28 md:px-8 md:pb-14 lg:px-8 lg:pb-16"
    data-hero-content
  >
    <div class="max-w-[48rem]" data-hero-copy-block>
      {
        brand ? (
          <h1
            class="w-fit max-w-full font-display text-[clamp(3.5rem,13vw,7.5rem)] leading-[0.88] tracking-[-0.035em] text-[var(--color-paper)]"
            data-hero-title
            data-hero-brand
            data-cursor-text
          >
            {brand}
          </h1>
        ) : null
      }

      <p
        class="hero-sur__line mt-6 w-fit max-w-[22ch] font-condensed text-[clamp(1.65rem,4.2vw,2.85rem)] leading-[1.05] tracking-[-0.01em] text-[var(--color-paper)] uppercase"
        data-hero-line
        data-cursor-text
      >
        <span class="hero-sur__l">{headline}</span>
        {headlineBold ? (
          <>
            {" "}
            <b class="hero-sur__b">{headlineBold}</b>
          </>
        ) : null}
        {headlineRest ? (
          <>
            {" "}
            <span class="hero-sur__l">{headlineRest}</span>
          </>
        ) : null}
        {headlineAccent ? (
          <>
            {" "}
            <span class="hero-sur__grad">{headlineAccent}</span>
          </>
        ) : null}
      </p>

      <p
        class="mt-5 w-fit max-w-[42ch] text-[0.975rem] leading-relaxed text-[var(--color-paper)]/75 md:text-base"
        data-hero-copy
        data-cursor-text
      >
        {subheadline}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3" data-hero-cta-wrap>
        <a href={primaryCta.href} class="btn-solid hero-sur__cta" data-hero-cta>
          {primaryCta.label}
          <span aria-hidden="true">→</span>
        </a>
        <a href={secondaryCta.href} class="btn-outline btn-outline-on-dark" data-hero-cta-secondary>
          {secondaryCta.label}
        </a>
      </div>
    </div>

    {
      meta ? (
        <div class="mt-14 border-t border-[var(--color-paper)]/15 pt-5" data-hero-meta>
          <p class="font-mono text-[11px] tracking-[0.14em] text-[var(--color-paper)]/55 uppercase">
            {meta}
          </p>
        </div>
      ) : null
    }
  </div>
</section>

<script>
  import gsap from "gsap";

  function initHero() {
    const root = document.querySelector("[data-hero]");
    if (!root || root.getAttribute("data-hero-ready") === "1") return;
    root.setAttribute("data-hero-ready", "1");

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const veil = root.querySelector("[data-hero-veil]");
    const brand = root.querySelector("[data-hero-title]");
    const line = root.querySelector("[data-hero-line]");
    const copy = root.querySelector("[data-hero-copy]");
    const ctas = root.querySelectorAll("[data-hero-cta], [data-hero-cta-secondary]");
    const meta = root.querySelector("[data-hero-meta]");

    if (reduce) {
      root.classList.add("is-hero-ready");
      return;
    }

    const ease = "cubic-bezier(0.16, 1, 0.3, 1)";
    const tl = gsap.timeline({
      defaults: { ease },
      onComplete: () => root.classList.add("is-hero-ready"),
    });

    if (veil) {
      gsap.set(veil, { opacity: 0.4 });
      tl.to(veil, { opacity: 1, duration: 1.1 }, 0);
    }

    if (brand) gsap.set(brand, { opacity: 1 });
    if (line) gsap.set(line, { opacity: 1 });

    if (copy) {
      gsap.set(copy, { y: 22, opacity: 0 });
      tl.to(copy, { y: 0, opacity: 1, duration: 0.7, clearProps: "transform" }, 0.4);
    }

    if (ctas.length) {
      gsap.set(ctas, { y: 18, opacity: 0 });
      tl.to(
        ctas,
        {
          y: 0,
          opacity: 1,
          duration: 0.65,
          stagger: 0.08,
          clearProps: "transform",
        },
        0.52,
      );
    }

    if (meta) {
      gsap.set(meta, { y: 20, opacity: 0 });
      tl.to(meta, { y: 0, opacity: 1, duration: 0.7, clearProps: "transform" }, 0.68);
    }
  }

  initHero();
  document.addEventListener("astro:page-load", initHero);
</script>

<style>
  /* Contiene el glow para que no se filtre a la sección blanca */
  .hero-sur__fx {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-sur__lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: calc(100% / 6) 100%;
    opacity: 0.07;
    color: var(--color-paper);
  }

  /* Glow detrás del copy — más bajo para no chocar con el navbar */
  .hero-sur__glow {
    --hero-gr: linear-gradient(90deg, #5cf2ff, #8b5cff);
    position: absolute;
    z-index: 1;
    left: 18%;
    top: 58%;
    width: 65vw;
    height: 65vw;
    max-width: 820px;
    max-height: 820px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(90px);
    opacity: 0.38;
    background: var(--hero-gr);
    transform: translate(-28%, -42%);
    animation: hero-glow 12s ease-in-out infinite alternate;
  }

  .hero-sur__glow--soft {
    left: 48%;
    top: 62%;
    width: 50vw;
    height: 50vw;
    max-width: 640px;
    max-height: 640px;
    opacity: 0.22;
    transform: translate(-35%, -35%);
    animation-duration: 14s;
    animation-direction: alternate-reverse;
  }

  @keyframes hero-glow {
    to {
      transform: translate(-16%, -48%) scale(1.12);
    }
  }

  /* Fade negro arriba → glow abajo: transición suave bajo el navbar */
  .hero-sur__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        to bottom,
        var(--color-ink) 0%,
        color-mix(in oklab, var(--color-ink) 88%, transparent) 12%,
        color-mix(in oklab, var(--color-ink) 45%, transparent) 32%,
        transparent 52%
      ),
      radial-gradient(ellipse 85% 55% at 28% 62%, rgba(92, 242, 255, 0.08), transparent 58%),
      radial-gradient(ellipse 70% 50% at 62% 68%, rgba(139, 92, 255, 0.07), transparent 60%),
      linear-gradient(to top, rgba(10, 10, 10, 0.4) 0%, transparent 42%);
  }

  [data-hero-content] {
    z-index: 3;
  }

  .hero-sur__l {
    font-weight: 300;
  }

  .hero-sur__b {
    font-weight: 800;
  }

  .hero-sur__grad {
    font-weight: 800;
    background: linear-gradient(90deg, #5cf2ff, #8b5cff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .hero-sur__cta {
    background-image: linear-gradient(90deg, #5cf2ff, #8b5cff);
    border-color: transparent;
    color: #0a0a0a;
  }

  .hero-sur__cta:hover {
    background-image: none;
    background-color: transparent;
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  [data-hero-copy] {
    color: color-mix(in oklab, var(--color-paper) 78%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-sur__glow {
      animation: none;
      filter: blur(70px);
      opacity: 0.38;
    }
  }
</style>
