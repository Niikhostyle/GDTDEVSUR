---
interface Props {
  eyebrow?: string;
  title: string;
  titleLight?: string;
  titleBold?: string;
  body: string;
  highlights?: string[];
  cta: { label: string; href: string };
  image?: string;
  imageAlt?: string;
}

const {
  eyebrow = "",
  title,
  titleLight = "",
  titleBold = "",
  body,
  cta,
  highlights = [],
} = Astro.props;

const light = titleLight || "";
const bold = titleBold || (!titleLight ? title : "");

const htmlBody = body.replace(/\*\*(.*?)\*\*/g, "<b>$1</b>");
---

<section id="nosotros" class="about-mmd reveal-section relative text-[var(--color-ink)]" data-reveal="soft">
  <div class="about-mmd__lines" aria-hidden="true"></div>

  <div class="about-mmd__inner relative z-[2] mx-auto max-w-[1240px] px-5 md:px-8">
    {
      eyebrow ? (
        <span class="about-mmd__ey reveal-item font-condensed">{eyebrow}</span>
      ) : null
    }

    <h2 class="about-mmd__cd reveal-item font-condensed" data-split-words>
      {
        light ? (
          <>
            <span class="about-mmd__l">{light}</span>{" "}
          </>
        ) : null
      }
      {bold ? <b>{bold}</b> : null}
    </h2>

    <div class="about-mmd__content">
      <div class="about-mmd__copy">
        <p class="about-mmd__lead reveal-item" set:html={htmlBody} />
        <a href={cta.href} class="reveal-item btn-ink about-mmd__cta">
          {cta.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        highlights.length > 0 ? (
          <ul class="reveal-item about-mmd__list">
            {highlights.map((item) => (
              <li>
                <span class="about-mmd__dot" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>
  </div>
</section>

<style>
  .about-mmd {
    position: relative;
    z-index: 2;
    isolation: isolate;
    background: #f5f5f2;
    padding-top: clamp(5rem, 10vw, 8.5rem);
    padding-bottom: clamp(4.5rem, 9vw, 7.5rem);
  }

  .about-mmd__lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background-image: linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: calc(100% / 6) 100%;
    opacity: 0.07;
    color: var(--color-ink);
  }

  .about-mmd__ey {
    display: block;
    margin-bottom: 1.1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #666;
  }

  .about-mmd__cd {
    max-width: min(16ch, 100%);
    margin: 0 0 1.5rem;
    font-size: clamp(2.85rem, 7vw, 6.5rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .about-mmd__cd b {
    display: inline;
    font-weight: 800;
  }

  .about-mmd__l {
    font-weight: 300;
  }

  .about-mmd__content {
    display: grid;
    gap: 2.5rem;
    margin-top: 0.25rem;
  }

  @media (min-width: 768px) {
    .about-mmd__content {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 3rem 3.5rem;
      align-items: start;
    }
  }

  .about-mmd__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .about-mmd__lead {
    max-width: 42rem;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.55;
    color: #666;
  }

  .about-mmd__lead b {
    font-weight: 800;
    color: var(--color-ink);
  }

  .about-mmd__cta {
    margin-top: 2rem;
  }

  .about-mmd__list {
    margin: 0;
    padding: 1.5rem 0 0;
    list-style: none;
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
  }

  @media (min-width: 768px) {
    .about-mmd__list {
      padding: 0 0 0 2.5rem;
      border-top: 0;
      border-left: 1.5px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
    }
  }

  .about-mmd__list li {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.45;
    color: #666;
  }

  .about-mmd__list li + li {
    margin-top: 1rem;
  }

  .about-mmd__dot {
    flex-shrink: 0;
    width: 0.375rem;
    height: 0.375rem;
    margin-top: 0.55em;
    border-radius: 999px;
    background: var(--color-ink);
  }

  @media (max-width: 700px) {
    .about-mmd__cd {
      max-width: none;
    }
  }
</style>
