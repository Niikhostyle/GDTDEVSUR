---
interface Props {
  brandName: string;
  footerNote: string;
  footerBlurb?: string;
  emails: string[];
  phones: string[];
  nav: { label: string; href: string }[];
  locale?: "es" | "en";
  mapLabel?: string;
  contactLabel?: string;
  location?: string;
  locationLabel?: string;
  emailLabel?: string;
  whatsappLabel?: string;
  /** Preferido sobre emails[0] si viene del CMS contact */
  contactEmail?: string;
}

const {
  brandName,
  footerNote,
  footerBlurb = "",
  emails,
  phones,
  nav,
  locale = "es",
  mapLabel,
  contactLabel,
  location = "",
  locationLabel,
  emailLabel,
  whatsappLabel,
  contactEmail = "",
} = Astro.props;

const labels = {
  map: mapLabel || (locale === "en" ? "Sitemap" : "Mapa"),
  contact: contactLabel || (locale === "en" ? "Contact" : "Contacto"),
  location: locationLabel || (locale === "en" ? "Location" : "Ubicación"),
  email: emailLabel || (locale === "en" ? "Email" : "Correo"),
  whatsapp: whatsappLabel || "WhatsApp",
};

const displayEmail =
  (typeof contactEmail === "string" && contactEmail.trim()) || emails[0] || "";
const displayPhone = phones[0] || "";
const waDigits = displayPhone.replace(/\D/g, "");
---

<footer class="section-rule bg-[var(--color-ink)] text-[var(--color-paper)]">
  <div
    class="footer-grid mx-auto grid max-w-[1200px] gap-8 px-5 py-10 md:grid-cols-[1.15fr_0.85fr_1.1fr] md:gap-8 md:px-8 md:py-11 lg:gap-10 lg:py-12"
  >
    <div class="footer-brand">
      <p class="font-display text-[1.65rem] leading-none tracking-tight md:text-[1.85rem]">{brandName}</p>
      {
        footerBlurb ? (
          <p class="mt-2.5 max-w-[34ch] text-[13px] leading-snug text-[var(--color-paper)]/60">
            {footerBlurb}
          </p>
        ) : null
      }
    </div>

    <div class="footer-map">
      <p class="label-mono mb-2.5 text-[var(--color-paper)]/50">{labels.map}</p>
      <ul class="footer-map__list text-sm text-[var(--color-paper)]/78">
        {
          nav.map((item) => (
            <li>
              <a class="footer-map__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-contact">
      <p class="label-mono mb-2.5 text-[var(--color-paper)]/50">{labels.contact}</p>
      <dl class="footer-contact__list">
        {
          location ? (
            <div class="footer-contact__row">
              <dt>{labels.location}</dt>
              <dd>{location}</dd>
            </div>
          ) : null
        }
        {
          displayEmail ? (
            <div class="footer-contact__row">
              <dt>{labels.email}</dt>
              <dd>
                <a href={`mailto:${displayEmail}`}>{displayEmail}</a>
              </dd>
            </div>
          ) : null
        }
        {
          displayPhone ? (
            <div class="footer-contact__row">
              <dt>{labels.whatsapp}</dt>
              <dd>
                <a
                  href={waDigits ? `https://wa.me/${waDigits}` : `tel:${displayPhone.replace(/\s/g, "")}`}
                  target={waDigits ? "_blank" : undefined}
                  rel={waDigits ? "noopener noreferrer" : undefined}
                >
                  {displayPhone}
                </a>
              </dd>
            </div>
          ) : null
        }
      </dl>
    </div>
  </div>

  <div class="border-t border-[var(--color-paper)]/12 px-5 py-3.5 md:px-8">
    <p class="mx-auto max-w-[1200px] font-mono text-[10.5px] tracking-wide text-[var(--color-paper)]/40">
      {footerNote}
    </p>
  </div>
</footer>

<style>
  .footer-map__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .footer-map__link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.15rem 0;
    color: inherit;
    transition: color 0.2s ease;
  }

  .footer-map__link:hover {
    color: #fa9658;
  }

  .footer-contact__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-paper) 10%, transparent);
  }

  .footer-contact__row {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid color-mix(in oklab, var(--color-paper) 10%, transparent);
  }

  .footer-contact__row dt {
    margin: 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-paper) 40%, transparent);
  }

  .footer-contact__row dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--color-paper);
  }

  .footer-contact__row a {
    color: inherit;
    transition: color 0.2s ease;
  }

  .footer-contact__row a:hover {
    color: #fa9658;
  }

  @media (min-width: 768px) {
    .footer-map__list {
      gap: 0.05rem;
    }

    .footer-map__link {
      min-height: 1.65rem;
      padding: 0.1rem 0;
    }

    .footer-contact__row {
      padding: 0.45rem 0;
    }
  }

  @media (max-width: 767px) {
    .footer-map__link {
      min-height: 2.5rem;
    }

    .footer-contact__row {
      padding: 0.7rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-map__link,
    .footer-contact__row a {
      transition: none;
    }
  }
</style>
