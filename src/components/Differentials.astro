---
interface Item {
  id: string;
  title: string;
  body: string;
  icon: string;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  items: Item[];
}

const { eyebrow, title, items } = Astro.props;

const icons: Record<string, string> = {
  tech: `<circle cx="12" cy="12" r="9" /><path d="M9.5 9.2c.6-1 1.5-1.5 2.6-1.5 1.6 0 2.7 1 2.7 2.4 0 1.2-.7 1.9-1.9 2.5l-.6.3c-.5.3-.8.6-.8 1.2" /><circle cx="12" cy="17.2" r=".8" fill="currentColor" stroke="none" />`,
  speed: `<path d="M13 2 4 14h7l-1 8 10-14h-7l1-6z" />`,
  motion: `<path d="M12 3l1.2 3.6L17 8l-3.2 1.4L12 13l-1.8-3.6L7 8l3.8-1.4L12 3z" /><path d="M18.5 13.5 19 15l1.5.5-1.5.5-.5 1.5-.5-1.5L17 15.5l1.5-.5.5-1.5z" /><path d="M5.5 14.5 6 16l1.2.4L6 16.8l-.5 1.2-.5-1.2L4 16.4l1.2-.4.3-1.5z" />`,
  future: `<rect x="4" y="4" width="16" height="16" rx="2" /><path d="M9 9h6v6H9z" /><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" />`,
  responsive: `<rect x="2" y="4" width="20" height="13" rx="1.5" /><path d="M8 21h8M12 17v4" />`,
  results: `<path d="M4 19V5M4 19h16" /><path d="M8 15v-3M12 15V9M16 15v-6" />`,
  "seo-geo": `<path d="M21 15a2 2 0 0 1-2 2H8l-4 3V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z" /><path d="M8 8h8M8 12h5" />`,
  cms: `<path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3z" /><path d="M12 12 4 7.5M12 12l8-4.5M12 12v9" />`,
};
---

<section id="enfoque" class="reveal-section bg-white px-5 py-16 md:px-8 md:py-24">
  <div class="mx-auto max-w-[1120px]">
    <div class="reveal-item mx-auto max-w-3xl text-center">
      <p class="mb-3 text-[11px] font-600 tracking-[0.22em] text-[var(--color-accent)] uppercase md:text-xs">
        {eyebrow}
      </p>
      <h2 class="font-display text-[1.75rem] leading-tight font-700 tracking-tight text-[#2a2a2a] md:text-[2.25rem]">
        {title}
      </h2>
    </div>

    <div class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <article class="vox-card p-1">
            <svg
              viewBox="0 0 24 24"
              class="mb-4 h-7 w-7 text-[var(--color-accent)]"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[item.icon] || icons.tech}
            />
            <h3 class="font-display text-[1.05rem] leading-snug font-700 text-[#2a2a2a] md:text-[1.1rem]">
              {item.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[#6b6b6b]">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
