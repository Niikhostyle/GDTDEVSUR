---
interface Item {
  id: string;
  title: string;
  client: string;
  category: string;
  image: string;
  url: string;
  featured: boolean;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  items: Item[];
  cta: { label: string; href: string };
}

const { eyebrow, title, subtitle, items, cta } = Astro.props;

/** /portfolio/x.webp → /portfolio/x-800.webp (variante generada junto al original) */
function srcsetFor(src: string) {
  const match = src.match(/^(\/portfolio\/[^?]+?)\.webp(\?.*)?$/);
  if (!match) return undefined;
  const [, base, query = ""] = match;
  return `${base}-800.webp${query} 800w, ${src} 1440w`;
}
---

<section id="portfolio" class="reveal-section bg-[var(--color-surface)] px-5 py-16 md:px-8 md:py-24">
  <div class="mx-auto max-w-[1120px]">
    <div class="reveal-item mx-auto max-w-2xl text-center">
      <p class="mb-3 text-[11px] font-600 tracking-[0.22em] text-[var(--color-accent)] uppercase md:text-xs">
        {eyebrow}
      </p>
      <h2 class="font-display text-[1.75rem] leading-tight font-700 tracking-tight text-[#2a2a2a] md:text-[2.15rem]">
        {title}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-[#6b6b6b] md:text-base">{subtitle}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        items.map((item, index) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="portfolio-card reveal-item group block"
            style={`--stagger: ${index * 90}ms`}
          >
            <div class="overflow-hidden rounded-2xl bg-white shadow-[0_12px_40px_rgba(0,0,0,0.08)] transition duration-500 group-hover:-translate-y-1.5 group-hover:shadow-[0_22px_55px_rgba(0,0,0,0.14)]">
              <div class="aspect-[16/10] overflow-hidden bg-[#eef2f7]">
                <img
                  src={item.image}
                  srcset={srcsetFor(item.image)}
                  sizes="(min-width: 640px) 544px, 100vw"
                  alt={item.title}
                  width="1440"
                  height="900"
                  class="h-full w-full object-cover object-left-top transition duration-700 ease-out group-hover:scale-[1.03]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="p-5 md:p-6">
                <p class="text-[11px] font-600 tracking-[0.16em] text-[var(--color-accent)] uppercase">
                  {item.category}
                </p>
                <h3 class="font-display mt-2 text-xl font-600 text-[#2a2a2a]">{item.title}</h3>
                <p class="mt-1 text-sm text-[#6b6b6b]">{item.client}</p>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="reveal-item mt-12 text-center">
      <a
        href={cta.href}
        class="inline-flex rounded-full border border-[var(--color-accent)] px-6 py-2.5 text-sm font-600 text-[var(--color-accent)] transition hover:bg-[var(--color-accent)] hover:text-white"
      >
        {cta.label}
      </a>
    </div>
  </div>
</section>
