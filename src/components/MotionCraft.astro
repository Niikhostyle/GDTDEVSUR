---
/**
 * Efectos portados de MMD Websites (scroll letras, cursor, magnetismo, sparks)
 * Adaptados a Carbón & Crema — sin gradiente cyan/morado.
 */
---

<div class="craft-prog" aria-hidden="true" data-craft-prog></div>
<div class="craft-cur" aria-hidden="true" data-craft-cur></div>
<div class="craft-cur2" aria-hidden="true" data-craft-cur2>
  <span class="craft-cur2__ring"></span>
  <span class="craft-cur-label" data-craft-cur-label>→</span>
</div>
<div class="craft-glow" aria-hidden="true" data-craft-glow></div>

<style is:global>
  .font-condensed {
    font-family: var(--font-condensed);
  }

  .craft-prog {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 95;
    height: 2px;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: var(--color-ink);
    pointer-events: none;
    mix-blend-mode: difference;
  }

  .craft-cur,
  .craft-cur2 {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    pointer-events: none;
    will-change: transform;
  }

  /* Cursor MMD: #fff + difference = contraste directo sobre papel/ink */
  .craft-cur {
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: #fff;
    mix-blend-mode: difference;
    transform: translate(var(--cx, -100px), var(--cy, -100px)) scale(var(--cs, 1));
    transition: opacity 0.22s ease;
  }

  .craft-cur.is-hot {
    opacity: 0;
    --cs: 0.15;
  }

  .craft-cur2 {
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    z-index: 9998;
    display: grid;
    place-items: center;
    mix-blend-mode: difference;
  }

  .craft-cur2__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid #fff;
    background: transparent;
    transition:
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.28s ease,
      border-color 0.28s ease,
      border-radius 0.32s ease;
  }

  .craft-cur-label {
    position: relative;
    z-index: 1;
    font-family: var(--font-condensed);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1;
    color: #06080d;
    opacity: 0;
    transform: scale(0.55) translateY(2px);
    transition:
      opacity 0.22s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Hover clickable: crece, relleno blanco, flecha */
  .craft-cur2.is-big .craft-cur2__ring {
    transform: scale(1.85);
    border-color: transparent;
    background: #fff;
  }

  .craft-cur2.is-big .craft-cur-label {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  /* Sobre texto marcado: disco más grande, sin label */
  .craft-cur2.is-text .craft-cur2__ring {
    transform: scale(2.35);
    border-color: transparent;
    background: #fff;
  }

  .craft-cur2.is-text .craft-cur-label {
    opacity: 0;
    transform: scale(0.5);
  }

  /* Click: pulso breve */
  .craft-cur2.is-press .craft-cur2__ring {
    transform: scale(1.35);
  }

  .craft-cur2.is-big.is-press .craft-cur2__ring {
    transform: scale(1.55);
  }

  .craft-glow {
    position: fixed;
    width: 380px;
    height: 380px;
    margin: -190px 0 0 -190px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.12), transparent 68%);
    mix-blend-mode: screen;
  }

  /* Partículas: blanco + difference (sello DevSur; sin cyan/morado MMD) */
  .craft-spark {
    position: fixed;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9997;
    background: #fff;
    mix-blend-mode: difference;
    animation: craft-spk 0.8s ease-out forwards;
  }

  @keyframes craft-spk {
    to {
      transform: translate(var(--dx), var(--dy)) scale(0);
      opacity: 0;
    }
  }

  .craft-ch {
    display: inline-block;
    transition:
      transform 0.5s cubic-bezier(0.34, 1.8, 0.64, 1),
      color 0.3s ease;
  }

  .craft-ch:hover {
    transform: translateY(-10px) rotate(-5deg) scale(1.08);
  }

  .craft-wd {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .craft-wd > span {
    display: inline-block;
    transform: translateY(105%);
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .craft-ready .craft-wd > span {
    transform: none;
  }

  h2[data-split-words].craft-fx .craft-w2 {
    opacity: 0.18;
    transition: opacity 0.28s ease;
  }

  h2[data-split-words].craft-fx .craft-w2.is-on {
    opacity: 1;
  }

  .craft-bigw {
    position: absolute;
    left: 0;
    z-index: 0;
    white-space: nowrap;
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: clamp(100px, 18vw, 280px);
    line-height: 1;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--color-paper) 22%, transparent);
    opacity: 0.35;
    pointer-events: none;
    will-change: transform;
  }

  .craft-mq {
    overflow: hidden;
    white-space: nowrap;
    padding: 1.75rem 0;
    background: var(--color-ink);
    color: var(--color-paper);
    border-block: 1px solid color-mix(in oklab, var(--color-paper) 14%, transparent);
  }

  .craft-mq > div {
    display: inline-block;
    font-family: var(--font-condensed);
    font-weight: 800;
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    line-height: 1;
    text-transform: uppercase;
    will-change: transform;
  }

  .craft-mq i {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-paper);
    margin: 0 0.35em;
  }

  .craft-mq b {
    font-weight: 800;
    margin: 0 0.35em;
  }

  .portfolio-cell [data-craft-tilt] {
    transform-style: preserve-3d;
    transition: transform 0.3s ease;
  }

  .portfolio-cell [data-craft-tilt]::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 50%),
      rgba(245, 245, 242, 0.28),
      transparent 55%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .portfolio-cell:hover [data-craft-tilt]::after {
    opacity: 1;
  }

  @media (hover: none), (pointer: coarse) {
    .craft-cur,
    .craft-cur2,
    .craft-glow,
    .craft-spark {
      display: none !important;
    }

    html.craft-cursor,
    html.craft-cursor body,
    html.craft-cursor a,
    html.craft-cursor button,
    html.craft-cursor [role="button"],
    html.craft-cursor summary,
    html.craft-cursor label[for],
    html.craft-cursor input,
    html.craft-cursor select {
      cursor: auto !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .craft-prog,
    .craft-cur,
    .craft-cur2,
    .craft-glow,
    .craft-spark,
    .craft-bigw {
      display: none !important;
    }

    .craft-ch,
    .craft-wd > span,
    h2[data-split-words].craft-fx .craft-w2 {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }

    html.craft-cursor,
    html.craft-cursor body,
    html.craft-cursor a,
    html.craft-cursor button,
    html.craft-cursor [role="button"],
    html.craft-cursor summary,
    html.craft-cursor label[for],
    html.craft-cursor input,
    html.craft-cursor select {
      cursor: auto !important;
    }
  }

  html.craft-cursor body {
    cursor: none;
  }

  /* Solo clickables / UI — inputs de texto conservan caret nativo */
  html.craft-cursor a,
  html.craft-cursor button,
  html.craft-cursor [role="button"],
  html.craft-cursor summary,
  html.craft-cursor label[for],
  html.craft-cursor input[type="submit"],
  html.craft-cursor input[type="button"],
  html.craft-cursor input[type="reset"],
  html.craft-cursor input[type="checkbox"],
  html.craft-cursor input[type="radio"],
  html.craft-cursor select,
  html.craft-cursor .btn-solid,
  html.craft-cursor .btn-ink,
  html.craft-cursor .btn-outline,
  html.craft-cursor .cta-wa {
    cursor: none;
  }

  html.craft-cursor input:not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="checkbox"]):not([type="radio"]),
  html.craft-cursor textarea,
  html.craft-cursor [contenteditable="true"] {
    cursor: text;
  }
</style>

<script>
  function initMotionCraft() {
    const root = document.documentElement;
    if (root.getAttribute("data-craft-ready") === "1") return;
    root.setAttribute("data-craft-ready", "1");

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const touch = window.matchMedia("(hover: none), (pointer: coarse)").matches;
    if (reduce) return;

    const prog = document.querySelector("[data-craft-prog]");
    const cur = document.querySelector("[data-craft-cur]");
    const cur2 = document.querySelector("[data-craft-cur2]");
    const glow = document.querySelector("[data-craft-glow]");

    let mx = -100;
    let my = -100;
    let x2 = -100;
    let y2 = -100;
    let gx = -100;
    let gy = -100;
    let lastSpark = 0;

    function spark(x, y, n) {
      if (touch) return;
      for (let i = 0; i < n; i++) {
        const s = document.createElement("i");
        s.className = "craft-spark";
        s.style.left = `${x}px`;
        s.style.top = `${y}px`;
        const a = Math.random() * Math.PI * 2;
        const d = 18 + Math.random() * 48;
        s.style.setProperty("--dx", `${Math.cos(a) * d}px`);
        s.style.setProperty("--dy", `${Math.sin(a) * d}px`);
        document.body.appendChild(s);
        window.setTimeout(() => s.remove(), 800);
      }
    }

    if (!touch && cur && cur2) {
      root.classList.add("craft-cursor");
      const curLabel = cur2.querySelector("[data-craft-cur-label]");
      const interactive =
        "a[href], button:not(:disabled), [role='button'], summary, label[for], " +
        "input[type='submit'], input[type='button'], input[type='reset'], " +
        "input[type='checkbox'], input[type='radio'], select, " +
        ".btn-solid, .btn-ink, .btn-outline, .cta-wa, [data-cursor]";

      /* Solo letras split (.craft-ch) o nodos marcados con caja w-fit (data-cursor-text).
         Antes: h1/p/span a ancho de bloque → el cursor crecía en el aire vacío. */
      function isTextHit(el) {
        if (!(el instanceof Element)) return false;
        if (el.closest("[aria-hidden='true']")) return false;
        if (el.closest(interactive)) return false;
        if (el.closest(".craft-ch, .craft-wd")) return true;
        if (el.closest("[data-cursor-text]")) return true;
        return !!el.closest(".que-hacemos__cell, .why-web__ck li");
      }

      function hitInteractive(el) {
        if (!(el instanceof Element)) return null;
        if (el.closest("input:not([type='submit']):not([type='button']):not([type='reset']):not([type='checkbox']):not([type='radio']), textarea, [contenteditable='true']")) {
          return null;
        }
        return el.closest(interactive);
      }

      function setHoverState(t) {
        const hit = hitInteractive(t);
        const onText = !hit && isTextHit(t);
        if (hit) {
          cur2.classList.add("is-big");
          cur2.classList.remove("is-text");
          cur.classList.add("is-hot");
          if (curLabel instanceof HTMLElement) {
            const custom = hit.getAttribute("data-cursor") || hit.getAttribute("data-cursor-label");
            curLabel.textContent = custom && custom.trim() ? custom.trim() : "→";
          }
        } else if (onText) {
          cur2.classList.add("is-text");
          cur2.classList.remove("is-big");
          cur.classList.add("is-hot");
        } else {
          cur2.classList.remove("is-text", "is-big");
          cur.classList.remove("is-hot");
        }
      }

      window.addEventListener(
        "pointermove",
        (e) => {
          mx = e.clientX;
          my = e.clientY;
          cur.style.setProperty("--cx", `${mx}px`);
          cur.style.setProperty("--cy", `${my}px`);
          const now = performance.now();
          if (now - lastSpark > 70) {
            lastSpark = now;
            spark(mx, my, 1);
          }
          setHoverState(e.target);
        },
        { passive: true },
      );

      window.addEventListener(
        "pointerdown",
        (e) => {
          if (hitInteractive(e.target) || isTextHit(e.target)) {
            cur2.classList.add("is-press");
          }
        },
        { passive: true },
      );
      window.addEventListener(
        "pointerup",
        () => cur2.classList.remove("is-press"),
        { passive: true },
      );
      window.addEventListener(
        "pointercancel",
        () => cur2.classList.remove("is-press"),
        { passive: true },
      );

      window.addEventListener("click", (e) => spark(e.clientX, e.clientY, 12));

      (function lag() {
        x2 += (mx - x2) * 0.18;
        y2 += (my - y2) * 0.18;
        cur2.style.transform = `translate(${x2}px, ${y2}px)`;
        if (glow) {
          gx += (mx - gx) * 0.08;
          gy += (my - gy) * 0.08;
          glow.style.transform = `translate(${gx}px, ${gy}px)`;
        }
        requestAnimationFrame(lag);
      })();
    }

    if (!touch) {
      document.querySelectorAll(".btn-solid, .btn-ink, .cta-wa").forEach((b) => {
        b.addEventListener("mousemove", (e) => {
          const r = b.getBoundingClientRect();
          const dx = (e.clientX - r.left - r.width / 2) * 0.18;
          const dy = (e.clientY - r.top - r.height / 2) * 0.22;
          b.style.transform = `translate(${dx}px, ${dy}px)`;
        });
        b.addEventListener("mouseleave", () => {
          b.style.transform = "";
        });
      });
    }

    function splitChars(el) {
      if (el.dataset.splitDone === "1") return;
      el.dataset.splitDone = "1";
      const walk = (node) => {
        [...node.childNodes].forEach((c) => {
          if (c.nodeType === 3 && c.textContent) {
            const frag = document.createDocumentFragment();
            [...c.textContent].forEach((ch) => {
              if (ch === " ") {
                frag.appendChild(document.createTextNode(" "));
                return;
              }
              const s = document.createElement("span");
              s.className = "craft-ch";
              s.textContent = ch;
              frag.appendChild(s);
            });
            node.replaceChild(frag, c);
          } else if (c.nodeType === 1) walk(c);
        });
      };
      walk(el);
    }

    function splitWordsEntrance(el) {
      if (el.dataset.wordsDone === "1") return;
      el.dataset.wordsDone = "1";
      const text = el.textContent || "";
      el.textContent = "";
      text.split(/(\s+)/).forEach((w, i) => {
        if (!w.trim()) {
          el.appendChild(document.createTextNode(w));
          return;
        }
        const wrap = document.createElement("span");
        wrap.className = "craft-wd";
        const inner = document.createElement("span");
        inner.textContent = w;
        inner.style.transitionDelay = `${i * 0.045}s`;
        wrap.appendChild(inner);
        el.appendChild(wrap);
      });
      requestAnimationFrame(() => {
        requestAnimationFrame(() => el.classList.add("craft-ready"));
      });
    }

    function splitWordsScroll(el) {
      if (el.dataset.splitWordsDone === "1") return;
      el.dataset.splitWordsDone = "1";
      el.classList.add("craft-fx");
      const walk = (node) => {
        [...node.childNodes].forEach((c) => {
          if (c.nodeType === 3 && c.textContent?.trim()) {
            const frag = document.createDocumentFragment();
            c.textContent.split(/(\s+)/).forEach((w) => {
              if (!w.trim()) {
                frag.appendChild(document.createTextNode(w));
                return;
              }
              const s = document.createElement("span");
              s.className = "craft-w2";
              s.textContent = w;
              frag.appendChild(s);
            });
            node.replaceChild(frag, c);
          } else if (c.nodeType === 1) walk(c);
        });
      };
      walk(el);
    }

    const brand = document.querySelector("[data-hero-title]");
    const line = document.querySelector("[data-hero-line]");
    if (brand) {
      splitWordsEntrance(brand);
      window.setTimeout(() => splitChars(brand), 60);
    }
    if (line) {
      splitWordsEntrance(line);
      window.setTimeout(() => splitChars(line), 90);
    }

    document.querySelectorAll("h2[data-split-words]").forEach(splitWordsScroll);

    /* Tilt 3D en portfolio */
    if (!touch) {
      document.querySelectorAll(".portfolio-cell [data-craft-tilt]").forEach((im) => {
        if (im.dataset.tiltBound === "1") return;
        im.dataset.tiltBound = "1";
        const cell = im.closest(".portfolio-cell");
        if (!cell) return;
        cell.addEventListener("mousemove", (e) => {
          const r = im.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width;
          const y = (e.clientY - r.top) / r.height;
          im.style.transform = `perspective(900px) rotateY(${(x - 0.5) * 10}deg) rotateX(${(0.5 - y) * 8}deg)`;
          im.style.setProperty("--gx", `${x * 100}%`);
          im.style.setProperty("--gy", `${y * 100}%`);
        });
        cell.addEventListener("mouseleave", () => {
          im.style.transform = "";
        });
      });
    }

    /* Arcos: bulge crece al acercarse (visible en viewport inferior), se aplana al pasar */
    const arcs = [...document.querySelectorAll("[data-arc]")];
    const arcState = arcs.map(() => 0.55);
    const reduceArc = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function updateArcs(immediate) {
      if (reduceArc) {
        arcs.forEach((a) => a.style.setProperty("--a", "0.55"));
        return;
      }
      arcs.forEach((a, i) => {
        const r = a.getBoundingClientRect();
        const ih = Math.max(innerHeight, 1);
        /* Pico ~0.55–1 cuando el arco está en el tercio inferior; aplana cerca del top */
        const visible = Math.min(1, Math.max(0, (ih - r.top) / (ih * 0.85)));
        const target = Math.min(1, Math.max(0.25, visible * 0.95));
        arcState[i] = immediate ? target : arcState[i] + (target - arcState[i]) * 0.14;
        a.style.setProperty("--a", arcState[i].toFixed(3));
      });
    }
    window.addEventListener("resize", () => updateArcs(true), { passive: true });
    updateArcs(true);

    /* #por-que owns its own "CÓDIGO" word inside [data-why-stats] — skip craft-bigw there */
    const words = ["Código", "Diseño", "Chile", "Web", "CMS", "DevSur"];
    const darkSecs = [
      ...document.querySelectorAll("#contacto, #faq, [data-hero]"),
    ];
    const bigs = [];
    darkSecs.forEach((s, i) => {
      if (getComputedStyle(s).position === "static") s.style.position = "relative";
      if (s.querySelector(".craft-bigw")) return;
      const b = document.createElement("div");
      b.className = "craft-bigw";
      b.setAttribute("aria-hidden", "true");
      b.textContent = `${(words[i % words.length] + " · ").repeat(5)}`;
      b.style.top = `${28 + (i % 2) * 36}%`;
      s.appendChild(b);
      bigs.push({ el: b, s, dir: i % 2 ? 1 : -1 });
    });

    let ly = window.scrollY;
    let vel = 0;

    function onFrame() {
      const y = window.scrollY;
      const H = document.documentElement.scrollHeight - window.innerHeight;
      vel += (y - ly - vel) * 0.15;
      ly = y;

      if (prog) prog.style.transform = `scaleX(${H > 0 ? y / H : 0})`;

      updateArcs(false);

      document.querySelectorAll("h2[data-split-words].craft-fx").forEach((h2) => {
        const r = h2.getBoundingClientRect();
        if (r.top > innerHeight || r.bottom < 0) return;
        const ws = h2.querySelectorAll(".craft-w2");
        const p = Math.min(1, Math.max(0, (innerHeight * 0.88 - r.top) / (innerHeight * 0.45)));
        const n = Math.ceil(p * ws.length);
        ws.forEach((w, i) => w.classList.toggle("is-on", i < n));
      });

      bigs.forEach((b) => {
        const r = b.s.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight) return;
        const p = (innerHeight - r.top) / (innerHeight + r.height);
        const skew = Math.max(-10, Math.min(10, vel * -0.35));
        b.el.style.transform = `translateX(${b.dir * p * -36 - 8}%) skewX(${skew}deg)`;
      });

      requestAnimationFrame(onFrame);
    }
    requestAnimationFrame(onFrame);
  }

  initMotionCraft();
  document.addEventListener("astro:page-load", () => {
    document.documentElement.removeAttribute("data-craft-ready");
    initMotionCraft();
  });
</script>
