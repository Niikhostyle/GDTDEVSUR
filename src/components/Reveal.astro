---
/**
 * Reveal fiel a MMD: .rv → opacity/translateY(40px) → .in
 * Re-observa islas React que montan después del primer pass.
 */
---

<style is:global>
  html.reveal-ready .mmd-rv,
  html.reveal-ready .reveal-item {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 1s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  html.reveal-ready .mmd-rv.in,
  html.reveal-ready .reveal-item.in,
  html.reveal-ready .reveal-item.is-revealed {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html.reveal-ready .mmd-rv,
    html.reveal-ready .reveal-item {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  let io = null;
  let mo = null;

  function revealEl(el) {
    el.classList.add("in", "is-revealed");
    if (io) io.unobserve(el);
  }

  function watch(el) {
    if (!(el instanceof HTMLElement)) return;
    if (el.classList.contains("in") || el.classList.contains("is-revealed")) return;
    if (el.dataset.revealWatch === "1") return;
    el.dataset.revealWatch = "1";

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      revealEl(el);
      return;
    }

    /* Ya en viewport (isla React montada tarde): revelar al toque */
    const r = el.getBoundingClientRect();
    const vh = window.innerHeight || 0;
    if (r.top < vh * 0.92 && r.bottom > 0) {
      revealEl(el);
      return;
    }

    if (io) io.observe(el);
  }

  function scan() {
    document.querySelectorAll(".mmd-rv, .reveal-item").forEach(watch);
  }

  function initMmdReveal() {
    document.documentElement.classList.add("reveal-ready");

    if (io) io.disconnect();
    io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          revealEl(entry.target);
        });
      },
      { threshold: 0.12 },
    );

    scan();

    if (mo) mo.disconnect();
    mo = new MutationObserver(() => scan());
    mo.observe(document.body, { childList: true, subtree: true });
  }

  initMmdReveal();
  document.addEventListener("astro:page-load", initMmdReveal);
</script>
