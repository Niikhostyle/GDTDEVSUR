---
interface Item {
  id: string;
  title: string;
  description: string;
  icon: string;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  items: Item[];
}

const { eyebrow, title, subtitle, items } = Astro.props;
---

<section id="servicios" class="reveal-section bg-[var(--color-surface)] px-5 py-16 md:px-8 md:py-24">
  <div class="mx-auto max-w-[1120px]">
    <div class="reveal-item max-w-3xl">
      <p class="mb-3 text-[11px] font-600 tracking-[0.22em] text-[var(--color-accent)] uppercase md:text-xs">
        {eyebrow}
      </p>
      <h2 class="font-display text-[1.75rem] leading-tight font-700 tracking-tight text-[#2a2a2a] md:text-[2.35rem] lg:text-[2.6rem]">
        {title}
      </h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[#6b6b6b] md:text-base">{subtitle}</p>
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item, index) => (
          <article
            class="reveal-item border-t border-[#2a2a2a]/12 pt-5"
            style={`--stagger: ${index * 60}ms`}
          >
            <span class="mb-3 block font-display text-sm font-700 tracking-[0.12em] text-[var(--color-accent)]">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="font-display text-xl font-600 text-[#2a2a2a]">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[#6b6b6b]">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
