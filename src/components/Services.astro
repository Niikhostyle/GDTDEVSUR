---
interface Item {
  id: string;
  title: string;
  description?: string;
  icon?: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  titleLight?: string;
  titleBold?: string;
  subtitle: string;
  items: Item[];
}

const {
  eyebrow = "",
  title,
  titleLight = "",
  titleBold = "",
  subtitle,
  items,
} = Astro.props;

const light = titleLight || (title ? title.split(/\s+/).slice(0, 3).join(" ") : "");
const bold = titleBold || "";
---

<section
  id="que-hacemos"
  class="que-hacemos has-arc-exit reveal-section relative text-[var(--color-ink)]"
  data-que-hacemos
>
  <div class="que-hacemos__lines" aria-hidden="true"></div>

  <div class="que-hacemos__wrap relative z-[2] mx-auto max-w-[1240px] px-5 md:px-8 lg:px-6">
    <span class="que-hacemos__ey font-condensed">{eyebrow}</span>

    <h2 class="que-hacemos__cd font-condensed mmd-rv" data-split-words>
      <span class="que-hacemos__l">{light}</span>
      {" "}
      <b>{bold}</b>
    </h2>

    <p class="que-hacemos__lead mmd-rv">{subtitle}</p>

    <div class="que-hacemos__svcs mmd-rv">
      {
        items.map((item, index) => (
          <a href={item.href || `#${item.id}`} class="que-hacemos__cell">
            <span class="que-hacemos__n font-condensed">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="font-condensed">{item.title}</h3>
            <span class="que-hacemos__ar" aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Blanco MMD --w:#f5f5f2 */
  .que-hacemos {
    background: #f5f5f2;
    isolation: isolate;
    padding-top: clamp(5rem, 10vw, 8.5rem);
    padding-bottom: 0;
  }

  .que-hacemos__lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background-image: linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: calc(100% / 6) 100%;
    opacity: 0.07;
    color: var(--color-ink);
  }

  .que-hacemos__ey {
    display: block;
    margin-bottom: 1.1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #666;
  }

  .que-hacemos__cd {
    max-width: min(16ch, 100%);
    margin: 0 0 1.5rem;
    font-size: clamp(2.85rem, 7vw, 6.5rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .que-hacemos__cd b {
    display: inline;
    font-weight: 800;
  }

  .que-hacemos__l {
    font-weight: 300;
  }

  .que-hacemos__lead {
    max-width: 38rem;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.55;
    color: #666;
  }

  .que-hacemos__svcs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 3.75rem;
    border-top: 1.5px solid currentColor;
  }

  .que-hacemos__cell {
    position: relative;
    z-index: 0;
    display: flex;
    min-height: 14.5rem;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: 2.1rem 1.35rem 1.85rem;
    border-right: 1px solid rgba(0, 0, 0, 0.12);
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    color: inherit;
    transition: color 0.4s ease;
  }

  .que-hacemos__cell:nth-child(4n) {
    border-right: 0;
  }

  .que-hacemos__cell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-ink);
    transform: translateY(101%);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .que-hacemos__cell:hover {
    color: #f5f5f2;
  }

  .que-hacemos__cell:hover::before {
    transform: none;
  }

  .que-hacemos__n {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .que-hacemos__cell h3 {
    margin: 1.25rem 0 auto;
    font-size: clamp(1.35rem, 2.2vw, 1.875rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .que-hacemos__ar {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .que-hacemos__cell:hover .que-hacemos__ar {
    transform: translate(6px, -6px);
  }

  @media (max-width: 1000px) {
    .que-hacemos__svcs {
      grid-template-columns: repeat(2, 1fr);
    }

    .que-hacemos__cell:nth-child(4n) {
      border-right: 1px solid rgba(0, 0, 0, 0.12);
    }

    .que-hacemos__cell:nth-child(2n) {
      border-right: 0;
    }
  }

  @media (max-width: 700px) {
    .que-hacemos__svcs {
      grid-template-columns: 1fr;
    }

    .que-hacemos__cell,
    .que-hacemos__cell:nth-child(2n),
    .que-hacemos__cell:nth-child(4n) {
      border-right: 0;
      min-height: 11rem;
    }

    .que-hacemos__cd {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .que-hacemos__cell::before,
    .que-hacemos__ar {
      transition: none !important;
    }
  }
</style>
