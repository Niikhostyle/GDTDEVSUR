---
interface DetailItem {
  id: string;
  label: string;
  title: string;
  body: string;
  note?: string;
  ctaLabel: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  titleLight?: string;
  titleBold?: string;
  subtitle?: string;
  items: DetailItem[];
}

const {
  eyebrow = "",
  titleLight = "",
  titleBold = "",
  subtitle = "",
  items = [],
} = Astro.props;
---

<section
  id="servicios"
  class="servicios-mmd reveal-section relative text-[var(--color-ink)]"
  data-servicios
>
  <div class="servicios-mmd__lines" aria-hidden="true"></div>

  <div class="servicios-mmd__wrap relative z-[2] mx-auto max-w-[1240px] px-5 pb-8 md:px-8 md:pb-10">
    <span class="servicios-mmd__ey font-condensed">{eyebrow}</span>

    <h2 class="servicios-mmd__cd font-condensed mmd-rv" data-split-words>
      <span class="servicios-mmd__l">{titleLight}</span>
      {" "}
      <b>{titleBold}</b>
    </h2>

    {subtitle ? <p class="servicios-mmd__lead mmd-rv">{subtitle}</p> : null}

    <div class="servicios-mmd__sd">
      {
        items.map((item) => (
          <article class="mmd-rv" id={item.id}>
            <span class="servicios-mmd__ey font-condensed">{item.label}</span>
            <h3 class="font-condensed">{item.title}</h3>
            <p>{item.body}</p>
            {item.note ? (
              <p class="servicios-mmd__inc" set:html={item.note.replace(/\*\*(.*?)\*\*/g, "<b>$1</b>")} />
            ) : null}
            <a class="servicios-mmd__lk" href={item.href || "#contacto"}>
              {item.ctaLabel}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .servicios-mmd {
    background: #f5f5f2;
    isolation: isolate;
    padding-top: clamp(5rem, 10vw, 8.5rem);
  }

  .servicios-mmd__lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background-image: linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: calc(100% / 6) 100%;
    opacity: 0.07;
    color: var(--color-ink);
  }

  .servicios-mmd__ey {
    display: block;
    margin-bottom: 1.1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #666;
  }

  .servicios-mmd__cd {
    max-width: min(18ch, 100%);
    margin: 0 0 1.5rem;
    font-size: clamp(2.85rem, 7vw, 6.5rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .servicios-mmd__cd b {
    display: inline;
    font-weight: 800;
  }

  .servicios-mmd__l {
    font-weight: 300;
  }

  .servicios-mmd__lead {
    max-width: 42rem;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.55;
    color: #666;
  }

  .servicios-mmd__sd {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 4.375rem;
    border-top: 1.5px solid currentColor;
  }

  .servicios-mmd__sd article {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 2.75rem 2.5rem 2.75rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  .servicios-mmd__sd article:nth-child(odd) {
    border-right: 1px solid rgba(0, 0, 0, 0.12);
    padding-right: 2.5rem;
  }

  .servicios-mmd__sd article:nth-child(even) {
    padding-left: 2.5rem;
  }

  .servicios-mmd__sd article .servicios-mmd__ey {
    margin-bottom: 0;
  }

  .servicios-mmd__sd h3 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.875rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .servicios-mmd__sd p {
    margin: 0;
    max-width: 38ch;
    font-size: 1rem;
    line-height: 1.55;
    color: #555;
  }

  .servicios-mmd__inc {
    font-size: 0.9375rem !important;
    color: #333 !important;
  }

  .servicios-mmd__inc :global(b) {
    color: var(--color-ink);
    font-weight: 700;
  }

  .servicios-mmd__lk {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    margin-top: 0.5rem;
    padding-bottom: 2px;
    border-bottom: 2px solid currentColor;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-ink);
    transition: gap 0.3s ease;
  }

  .servicios-mmd__lk:hover {
    gap: 0.875rem;
  }

  @media (max-width: 900px) {
    .servicios-mmd__sd {
      grid-template-columns: 1fr;
    }

    .servicios-mmd__sd article,
    .servicios-mmd__sd article:nth-child(odd),
    .servicios-mmd__sd article:nth-child(even) {
      padding: 2rem 0;
      border-right: 0;
    }

    .servicios-mmd__cd {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .servicios-mmd__lk {
      transition: none;
    }
  }
</style>
