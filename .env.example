PUBLIC_SITE_URL=https://gdtdevsur.cl

# Los usuarios admin están en la tabla admin_users (no en .env):
#   npm run admin:password -- correo@ejemplo.com
# ADMIN_SESSION_SECRET (clave de firma de sesiones): aleatorio, >= 32 caracteres (openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# MariaDB / MySQL
POSTGRES_USER=gdtdevsur
POSTGRES_PASSWORD=cambiar-por-clave-local
POSTGRES_DB=gdtdevsur
POSTGRES_PORT=3307
DATABASE_URL="mysql://gdtdevsur:cambiar-por-clave-local@127.0.0.1:3307/gdtdevsur"

HOST=0.0.0.0
PORT=4321

# SMTP (todos los correos salientes usan SMTP_FROM_* = noreply)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Grupo Desarrollo Tecnológico Devsur"
SMTP_FROM_EMAIL="noreply@gdtdevsur.cl"
# Avisos internos del formulario de contacto (coma-separado)
SMTP_NOTIFY_TO="nfigueroa@gdtdevsur.cl"

# Scripts scripts/vps-*.py (solo en tu máquina, nunca en el servidor)
VPS_HOST=
VPS_USER=
VPS_PORT=22
# Preferido: clave SSH (o ssh-agent). VPS_PASSWORD solo como último recurso.
VPS_KEY_PATH=~/.ssh/id_ed25519
VPS_PASSWORD=
